# --- API / painel ---------------------------------------------------------- #
# Portas (configuráveis). O painel (SPA) é servido pelo próprio container em
# FRONT_PORT e fala DIRETO com a API em API_PORT (conexão direta, sem nginx).
FRONT_PORT=3000
API_PORT=3001
# TLS da API: off = HTTP (padrão; evita o prompt de cert self-signed no browser
# na conexão direta). on = HTTPS self-signed (aí aponte a base p/ https://…).
# API_TLS=off
# Token Bearer exigido pela API (gere um forte). Também é o bearer "root" do
# usuário master (identidade com todas as permissões).
API_TOKEN=change-this-token
# Credenciais do usuário MASTER (o do .env): não editável, todas as permissões.
# Os demais usuários são criados no painel (tela Usuários) com papéis
# admin/operator/viewer. Ver api/rbac.py.
API_USER=admin
API_PASSWORD=change-this-password
# Nome/e-mail do usuário master (só p/ exibição no perfil/avatar). Opcionais.
# API_NAME=Administrador
# API_EMAIL=admin@exemplo.com
# Validade (em dias) do token de sessão dos usuários do banco (padrão 7).
# SESSION_TTL_DAYS=7
# Origens permitidas por CORS (padrão "*").
# API_CORS_ORIGINS=https://nexus.goholtz.com

# --- Banco (métricas / auditoria) ------------------------------------------ #
# DB_TYPE: sqlite (padrão) | mysql | postgresql
DB_TYPE=sqlite
# Para mysql/postgresql, preencha:
# DB_USER=holtz
# DB_PASS=password
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=nexus
# Ou uma DSN completa (tem prioridade sobre as variáveis acima):
# DB_DSN=postgresql+psycopg2://holtz:password@db:5432/nexus
